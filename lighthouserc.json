{
  "ci": {
    "collect": {
      "url": ["http://localhost:8000/index.php"],
      "url": ["http://localhost:8000/pages/booking.php"],
      "url": ["http://localhost:8000/pages/donate.php"],
      "url": ["http://localhost:8000/pages/login.php"],
      "url": ["http://localhost:8000/pages/page_404.php"],
      "url": ["http://localhost:8000/pages/search.php"],
      "url": ["http://localhost:8000/pages/signup.php"]
    },

    "assert": {
      "assertions": {
        "errors-in-console": "on",
        "document-latency-insight": "on",
        "image-delivery-insight": "on",
        "network-dependency-tree-insight": "on",
        "offscreen-images": "on",
        "uses-optimized-images": "on",
        "uses-responsive-images": "on",
        "uses-text-compression": "on"
      }
    },

    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
